---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Tag from '../../components/Tag.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import PreviewDialog from '../../components/PreviewDialog.astro';
import { projects } from '../../data/portfolio';

export const getStaticPaths = (() => {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props;
const nextProject = projects[(projects.findIndex((item) => item.slug === project.slug) + 1) % projects.length];
const caption = project.image ? 'Project screenshot' : ['proxy', 'agents'].includes(project.visual) ? 'Integration diagram' : 'Interface illustration';
---
<Layout title={`${project.name} | Carlos Manuel González`} description={project.summary} project={project}>
  <article class="mx-auto max-w-6xl px-5 pt-10 sm:px-8 sm:pt-16 lg:px-12">
    <a href="/#work" class="mb-10 inline-flex min-h-10 items-center gap-2 font-mono text-[10px] text-muted hover:text-accent"><span aria-hidden="true">←</span> Back to selected work</a>
    <header>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] uppercase tracking-[.12em] text-muted"><span>{project.category}</span><span class="inline-flex items-center gap-2 normal-case tracking-normal"><span class="size-1.5 rounded-full bg-accent" />{project.status}</span></div>
      <h1 class="mt-5 text-5xl font-medium tracking-[-.065em] sm:text-7xl">{project.name}<span class="text-accent">.</span></h1>
      <p class="mt-5 max-w-2xl text-xl leading-relaxed tracking-[-.025em] text-muted sm:text-2xl">{project.headline}</p>
      <div class="mt-6 flex flex-wrap gap-2">{project.tags.map((label) => <Tag label={label} />)}</div>
      <div class="my-8 flex flex-wrap items-center gap-4">{project.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-3 rounded-sm bg-ink px-5 text-xs text-white transition-colors hover:bg-accent">{link.label}<Icon name="external" /><span class="sr-only">, opens in a new tab</span></a>)}<span class="font-mono text-[10px] text-muted">{project.sourceNote}</span></div>
    </header>
    <figure>
      <button type="button" data-preview data-title={project.name} data-description={project.headline} data-href={`/work/${project.slug}/`} data-caption={caption} aria-label={`Enlarge ${project.name} ${caption.toLowerCase()}`} class="group/preview relative block w-full cursor-zoom-in overflow-hidden rounded-sm border border-line"><ProjectPreview project={project} loading="eager" /><span class="absolute right-5 bottom-5 flex size-11 items-center justify-center rounded-full border border-line bg-white/90 transition-colors group-hover/preview:bg-accent group-hover/preview:text-white"><Icon name="plus" class="size-5" /></span></button>
      <figcaption class="mt-3 font-mono text-[10px] text-muted">{caption}{!project.image && ' · A visual explanation of the project, not a product screenshot.'}</figcaption>
    </figure>
    <div class="mt-12 grid gap-10 border-t border-line pt-10 pb-16 lg:grid-cols-[.65fr_2fr] lg:gap-20 lg:pb-24">
      <aside><h2 class="font-mono text-[10px] uppercase tracking-[.15em] text-muted">Project notes</h2><nav aria-label="Project sections" class="mt-5 flex flex-wrap gap-x-5 gap-y-3 text-xs lg:flex-col lg:items-start"><a href="#overview" class="hover:text-accent">Overview</a><a href="#contribution" class="hover:text-accent">My contribution</a><a href="#decisions" class="hover:text-accent">Decisions</a><a href="#outcome" class="hover:text-accent">Outcome & limitations</a></nav></aside>
      <div class="space-y-12">
        <section id="overview" class="scroll-mt-10"><h2 class="text-2xl font-semibold tracking-[-.04em]">The starting point</h2><p class="mt-4 text-sm leading-8 text-muted">{project.overview}</p><p class="mt-4 text-sm leading-8 text-muted">{project.problem}</p></section>
        <section id="contribution" class="scroll-mt-10"><h2 class="text-2xl font-semibold tracking-[-.04em]">What I built</h2><ul class="mt-5 space-y-4">{project.contributions.map((item) => <li class="flex gap-4 text-sm leading-7 text-muted"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" /><span>{item}</span></li>)}</ul></section>
        <section id="decisions" class="scroll-mt-10"><h2 class="text-2xl font-semibold tracking-[-.04em]">A few decisions along the way</h2><div class="mt-5 space-y-6">{project.decisions.map((decision, index) => <div class="border-t border-line pt-5"><p class="font-mono text-[10px] text-accent">0{index + 1}</p><h3 class="mt-2 text-sm font-semibold">{decision.title}</h3><p class="mt-2 text-sm leading-7 text-muted">{decision.text}</p></div>)}</div></section>
        <section id="outcome" class="scroll-mt-10 border-l-2 border-accent pl-5"><h2 class="text-2xl font-semibold tracking-[-.04em]">Where it stands</h2><p class="mt-4 text-sm leading-8 text-muted">{project.outcome}</p><p class="mt-4 text-sm leading-8 text-muted">{project.next}</p></section>
      </div>
    </div>
    <a href={`/work/${nextProject.slug}/`} class="group flex flex-wrap items-center justify-between gap-6 border-t border-line py-10 transition-colors hover:text-accent"><span><span class="font-mono text-[10px] uppercase tracking-[.14em] text-muted">Next project</span><span class="mt-2 block text-3xl font-medium tracking-[-.05em]">{nextProject.name}</span></span><Icon name="arrow" class="size-7 transition-transform group-hover:translate-x-1" /></a>
  </article>
  <PreviewDialog />
</Layout>
