---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Tag from '../components/Tag.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PreviewDialog from '../components/PreviewDialog.astro';
import { profile, experience, earlierExperience, projects, additionalWork } from '../data/portfolio';
const featured = projects.filter((project) => project.featured);
const capabilities = [
  { title: 'Build products', text: 'TypeScript · Node.js · NestJS · React · Next.js · PostgreSQL' },
  { title: 'Integrate AI', text: 'AI agents · Tool calling · RAG · MCP · Model gateways' },
  { title: 'Ship & understand', text: 'Docker · CI/CD · Grafana · Distributed systems' },
  { title: 'Keep exploring', text: 'AWS · Terraform · Infrastructure experiments' },
];
---
<Layout>
  <div class="mx-auto max-w-6xl px-5 sm:px-8 lg:px-12">
    <section aria-labelledby="intro-heading" class="relative isolate border-b border-line pt-14 pb-9 sm:pt-20 sm:pb-10 lg:pt-24">
      <div aria-hidden="true" class="pointer-events-none absolute -inset-x-5 top-0 -z-10 h-[540px] overflow-hidden sm:-inset-x-8 lg:-inset-x-12">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#2021200a_1px,transparent_1px),linear-gradient(to_bottom,#2021200a_1px,transparent_1px)] bg-size-[40px_40px] mask-[radial-gradient(ellipse_at_75%_20%,black,transparent_68%)]"></div>
        <div class="absolute -top-16 right-0 size-96 rounded-full bg-accent/4 blur-3xl"></div>
      </div>
      <div class="mb-10 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[10px] text-muted sm:mb-12">
        <span class="inline-flex items-center gap-2"><span class="size-1.5 rounded-full bg-accent"></span>BASED IN MEXICO</span>
        <span aria-hidden="true" class="text-line">/</span>
        <span>OPEN TO REMOTE OPPORTUNITIES</span>
      </div>
      <div class="grid items-center gap-10 md:grid-cols-[1fr_230px] lg:grid-cols-[1fr_270px] lg:gap-16">
        <div>
          <p class="mb-5 text-sm text-muted">Hi, I'm <span class="font-semibold text-ink">Carlos Manuel González</span>.</p>
          <h1 id="intro-heading" class="max-w-3xl text-[clamp(2.65rem,6.1vw,4.75rem)] leading-[1.08] font-medium tracking-[-.065em]">Building software.<br /><span class="text-accent">Making AI useful.</span></h1>
          <p class="mt-7 text-sm font-semibold tracking-[-.01em] sm:text-base">Software Engineer <span class="mx-1 font-normal text-muted">&</span> AI Engineer</p>
          <p class="mt-3 max-w-[32rem] text-sm leading-7 text-muted sm:text-[15px]">I build full-stack applications, backend systems, and AI integrations. My work spans SaaS platforms, payments, and agents that can take action.</p>
          <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-6">
            <a href="#work" class="group inline-flex min-h-12 items-center gap-4 rounded-sm bg-ink px-5 text-xs font-medium text-white transition-colors hover:bg-accent">Explore my work <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" /></a>
            <a href={`mailto:${profile.email}`} class="inline-flex min-h-12 items-center gap-2 px-1 text-xs font-medium transition-colors hover:text-accent">Get in touch <Icon name="external" class="size-4" /></a>
          </div>
        </div>
        <figure class="relative hidden md:block">
          <div class="absolute -top-3 -right-3 -bottom-3 left-3 border border-line" aria-hidden="true"></div>
          <div class="relative flex aspect-[.83] flex-col items-center justify-center overflow-hidden border border-line bg-[#e8e9e3]">
            {profile.portrait ? <img src={profile.portrait} alt="Carlos Manuel González" width="540" height="650" class="absolute inset-0 h-full w-full object-cover grayscale" /> : <>
              <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(#20212025_1px,transparent_1px)] bg-size-[12px_12px] mask-[radial-gradient(ellipse,black,transparent_75%)]"></div>
              <span aria-hidden="true" class="relative font-sans text-8xl font-medium tracking-[-.12em] text-ink/65">cm<span class="text-accent">.</span></span>
              <span class="absolute bottom-5 font-mono text-[9px] tracking-[.12em] text-muted">PORTRAIT PLACEHOLDER</span>
            </>}
            <span aria-hidden="true" class="absolute top-3 left-3 size-3 border-t border-l border-ink/40"></span>
            <span aria-hidden="true" class="absolute right-3 bottom-3 size-3 border-r border-b border-ink/40"></span>
          </div>
          <figcaption class="relative mt-6 flex justify-between font-mono text-[9px] text-muted"><span>HUMAN BEHIND THE CODE</span><span class="text-accent">[ CM / 01 ]</span></figcaption>
        </figure>
      </div>
      <div class="mt-14 flex flex-wrap items-center justify-between gap-6 border-t border-line pt-6 lg:mt-20">
        <p class="font-mono text-[10px] text-muted">FULL-STACK THINKING. BACKEND DEPTH.</p>
        <div class="flex flex-wrap gap-5">{profile.socials.map((social) => <a href={social.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-8 items-center gap-1.5 font-mono text-[10px] text-muted transition-colors hover:text-accent">{social.label}<Icon name="external" class="size-3" /><span class="sr-only">, opens in a new tab</span></a>)}</div>
      </div>
    </section>

    <section id="experience" aria-labelledby="experience-heading" class="scroll-mt-8 border-b border-line py-16 sm:py-20 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-[.85fr_2fr] lg:gap-16">
        <div>
          <p class="mb-5 font-mono text-[10px] uppercase tracking-[.18em] text-muted"><span class="mr-3 text-accent">01</span> Experience</p>
          <h2 id="experience-heading" class="text-4xl leading-[1.15] font-medium tracking-[-.055em]">Where I've<br class="hidden lg:block" /> put it to work<span class="text-accent">.</span></h2>
          <p class="mt-5 max-w-xs text-sm leading-7 text-muted">Production systems, changing requirements, and the people who rely on them.</p>
          <a href="#work" class="mt-6 inline-flex min-h-10 items-center gap-2 font-mono text-[10px] text-muted hover:text-accent">Then, the side projects <span aria-hidden="true">↓</span></a>
        </div>
        <div class="relative border-l border-line pl-7 sm:pl-9">
          {experience.map((job, index) => <article class:list={['relative', index > 0 && 'mt-10 border-t border-line pt-9']}>
            <span aria-hidden="true" class:list={['absolute -left-[33px] size-[9px] rounded-full border-2 border-paper sm:-left-[41px]', job.current ? 'top-2 bg-accent ring-4 ring-accent/10' : 'top-11 bg-ink']} />
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
              <h3 class="text-xl font-semibold tracking-[-.04em]">{job.company}</h3>
              <p class="font-mono text-[10px] text-muted">{job.period}</p>
            </div>
            <p class="mt-2 font-mono text-[10px] text-muted">{job.context}</p>
            <div class="mt-5 flex flex-col gap-2">{job.roles.map((role) => <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><p class="text-xs font-semibold">{role.title}</p>{job.roles.length > 1 && <span class="font-mono text-[9px] text-muted">{role.period}</span>}</div>)}</div>
            <p class="mt-4 text-sm leading-7 text-muted">{job.description}</p>
            <ul class="mt-3 space-y-2">{job.points.map((point) => <li class="flex gap-3 text-xs leading-6 text-muted"><span class="mt-2.5 size-1 shrink-0 rounded-full bg-ink/35" aria-hidden="true" /><span>{point}</span></li>)}</ul>
            <div class="mt-5 flex flex-wrap gap-1.5">{job.tags.map((label) => <Tag label={label} />)}</div>
            {job.caseStudy && <a href={job.caseStudy} class="mt-4 inline-flex min-h-10 items-center gap-2 text-xs font-semibold text-accent hover:underline">Inside the AI platform <Icon name="arrow" /></a>}
          </article>)}
          <details class="group mt-7 border-t border-line pt-3">
            <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between text-xs font-medium text-muted transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">Earlier experience <span class="transition-transform group-open:rotate-45"><Icon name="plus" /></span></summary>
            <div class="space-y-6 pt-4 pb-2">{earlierExperience.map((job) => <article><div class="flex flex-wrap justify-between gap-2"><h3 class="text-sm font-semibold">{job.company}</h3><p class="font-mono text-[9px] text-muted">{job.period}</p></div><p class="mt-1 text-xs text-muted">{job.title}</p><p class="mt-2 text-xs leading-6 text-muted">{job.description}</p></article>)}</div>
          </details>
        </div>
      </div>
    </section>

    <section id="work" aria-labelledby="work-heading" class="scroll-mt-8 py-16 sm:py-20 lg:py-24">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <div><p class="mb-5 font-mono text-[10px] uppercase tracking-[.18em] text-muted"><span class="mr-3 text-accent">02</span> Selected work</p><h2 id="work-heading" class="text-4xl font-medium tracking-[-.055em] sm:text-5xl">Built out of curiosity<span class="text-accent">.</span></h2></div>
        <p class="max-w-[16rem] text-xs leading-6 text-muted">Personal products and small tools.<br />Things I wanted to exist, so I built them.</p>
      </div>
      <div data-work-track class="relative">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 -bottom-2 -left-6 hidden w-px bg-line lg:block">
          <span data-work-progress class="absolute top-0 w-px bg-accent"></span>
          <span data-work-marker class="absolute -left-[6px] flex size-[13px] items-center justify-center rounded-[3px] bg-accent shadow-[0_0_0_5px_#f6f6f3]"><span class="size-1 rotate-45 bg-white"></span></span>
        </div>
        <div class="grid gap-x-8 gap-y-10 md:grid-cols-2">{featured.map((project, index) => <ProjectCard project={project} index={index} wide={index === 0} />)}</div>
      </div>
      <div class="mt-14 border-t border-line pt-7">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-4"><h3 class="font-mono text-[10px] uppercase tracking-[.15em] text-muted">Also on my workbench</h3><a href="https://github.com/cmglezpdev?tab=repositories" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-9 items-center gap-2 font-mono text-[10px] text-muted hover:text-accent">More on GitHub <Icon name="external" class="size-3" /><span class="sr-only">, opens in a new tab</span></a></div>
        {additionalWork.map((item) => <a href={item.url} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between gap-5 border-b border-line py-5 transition-colors hover:text-accent"><div><div class="flex flex-wrap items-center gap-x-4 gap-y-2"><h4 class="text-sm font-semibold">{item.name}</h4><span class="font-mono text-[9px] text-muted">{item.tag}</span></div><p class="mt-2 max-w-xl text-xs leading-6 text-muted">{item.description}</p></div><Icon name="external" class="size-4 shrink-0 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" /><span class="sr-only">, opens in a new tab</span></a>)}
      </div>
    </section>

    <section id="about" aria-labelledby="about-heading" class="scroll-mt-8 border-t border-line py-16 sm:py-20 lg:py-24">
      <p class="mb-5 font-mono text-[10px] uppercase tracking-[.18em] text-muted"><span class="mr-3 text-accent">03</span> A little about me</p>
      <div class="grid gap-10 md:grid-cols-2 md:gap-16">
        <div>
          <h2 id="about-heading" class="text-4xl leading-[1.15] font-medium tracking-[-.055em]">I learn by building.<br />Then taking it apart<span class="text-accent">.</span></h2>
          <p class="mt-6 text-sm leading-7 text-muted">I'm a Cuban software engineer based in Mexico, with a Computer Science degree from the University of Havana. I've worked across frontend and backend, with most of my professional experience rooted in backend systems.</p>
          <p class="mt-4 text-sm leading-7 text-muted">These days I'm focused on full-stack products and practical AI engineering. Outside work, I build tools I use myself, practice English with Nativo, and explore AWS by deploying infrastructure with Terraform, testing it, and tearing it down.</p>
          <p class="mt-6 inline-flex items-center gap-2 font-mono text-[10px] text-muted"><span class="size-1.5 rounded-full bg-accent"></span>Always something in progress.</p>
        </div>
        <div class="grid grid-cols-1 content-start gap-x-6 gap-y-6 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">{capabilities.map((item, index) => <div class="border-t border-line pt-4"><span class="font-mono text-[9px] text-accent">0{index + 1} /</span><h3 class="mt-3 text-sm font-semibold">{item.title}</h3><p class="mt-2 text-xs leading-6 text-muted">{item.text}</p></div>)}</div>
      </div>
    </section>
  </div>
  <PreviewDialog />
</Layout>
