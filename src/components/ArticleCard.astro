---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Tag from './Tag.astro';
import { articlePath, formatArticleDate, readingMinutes, type Article } from '../utils/articles';
interface Props { article: Article; }
const { article } = Astro.props;
const { title, description, publishedAt, tags, cover } = article.data;
---
<article class="group/article border-t border-line pt-6 pb-8 last:pb-0">
  {cover && <a href={articlePath(article)} tabindex="-1" aria-hidden="true" class="mb-6 block overflow-hidden rounded-sm border border-line"><Image src={cover.src} alt="" sizes="(min-width: 72rem) 696px, (min-width: 64rem) 66vw, (min-width: 40rem) calc(100vw - 4rem), calc(100vw - 2.5rem)" class="h-auto w-full transition-transform duration-300 motion-safe:group-hover/article:scale-[1.015]" /></a>}
  <p class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-meta text-muted"><time datetime={publishedAt.toISOString().slice(0, 10)}>{formatArticleDate(publishedAt)}</time><span aria-hidden="true">/</span><span>{readingMinutes(article)} min read</span></p>
  <h3 class="mt-3 text-2xl font-semibold tracking-[-.03em]"><a href={articlePath(article)} class="transition-colors hover:text-accent">{title}</a></h3>
  <p class="mt-3 max-w-2xl text-body text-copy">{description}</p>
  {tags.length > 0 && <div class="mt-5 flex flex-wrap gap-1.5">{tags.map((label) => <Tag label={label} />)}</div>}
  <a href={articlePath(article)} class="mt-5 inline-flex min-h-10 items-center gap-2 text-control font-semibold transition-colors hover:text-accent">Read article<span class="sr-only">: {title}</span> <Icon name="arrow" class="size-4 transition-transform motion-safe:group-hover/article:translate-x-0.5" /></a>
</article>
