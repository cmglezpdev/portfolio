---
import type { Project } from '../types/portfolio';
interface Props { project: Project; loading?: 'eager' | 'lazy'; }
const { project, loading = 'lazy' } = Astro.props;
const caption = ['proxy', 'agents'].includes(project.visual) ? 'Integration diagram' : 'Interface illustration';
const slides = project.images.length ? project.images : [{ src: `/images/${project.visual}.svg`, description: `${project.name}: ${caption.toLowerCase()}.` }];
const imageClass = 'relative z-10 block h-full w-full object-contain transition-transform duration-700 motion-safe:group-hover/preview:scale-[1.025]';
---
<div class="relative isolate aspect-[1000/650] w-full overflow-hidden bg-paper">
  {slides.map((slide, index) => index === 0 ? (
    <img data-preview-main src={slide.src} alt={slide.description} loading={loading} decoding="async" class={imageClass} />
  ) : (
    <template data-preview-slide>
      <img data-preview-main src={slide.src} alt={slide.description} decoding="async" />
    </template>
  ))}
</div>
